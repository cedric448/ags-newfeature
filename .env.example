# AGS 测试环境变量模板
# 复制为 .env 并填入真实值。.env 不要提交到代码仓库。

# ---------------- 腾讯云控制面 ----------------
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-beijing

# ---------------- E2B 数据面 ----------------
E2B_API_KEY=
E2B_DOMAIN=ap-beijing.tencentags.com

# ---------------- 网络（VPC 模式）----------------
AGS_VPC_ID=vpc-ovochv3a
AGS_SUBNET_ID=subnet-pac3o08j
# 可选：安全组 ID
AGS_SECURITY_GROUP_ID=

# ---------------- TCR 镜像仓库 ----------------
TCR_INSTANCE=tcr-mvlaq1sq
TCR_USERNAME=100000881922
TCR_PASSWORD=

# ---------------- 被测资源（按指导创建后回填）----------------
# AgentBucket 用的 CAM 角色（含 QcloudSMHFullAccess）
AGS_ROLE_ARN=
# SMH 媒体库 ID，形如 smh2ke12fou96sys
AGENTBUCKET_LIBRARY_ID=
# SMH 空间 ID，启动实例时作为 x-mounts[].subPath
AGENTBUCKET_SPACE_ID=
# AgentCFS 文件系统 ID，形如 cfs-xxxxxxxx
AGENTCFS_FILE_SYSTEM_ID=
AGENTCFS_PATH=/

# ---------------- 测试行为 ----------------
AGS_TEST_PREFIX=agstest
# 设为 1 时保留测试资源不回收（排障用）
AGS_KEEP_RESOURCES=0
